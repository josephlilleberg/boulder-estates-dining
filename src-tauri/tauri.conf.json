{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Boulder Estates Dining",
  "version": "0.1.2",
  "identifier": "com.boulderestates.dining",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Boulder Estates Dining",
        "width": 1366,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Seating and setup sheets for the dining room",
    "longDescription": "Boulder Estates dining: residents, seating, room layout, and printed setup and server sheets.",
    "publisher": "Boulder Estates",
    "category": "Productivity",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ]
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVEMjY4REQ4RjVEOTEwRTMKUldUakVObjEySTBtWFJoaFFzRHMyMUVoRGhmSmF3emhhdm1yc0dVMTlKNzBteU9saEgxaGhOVE4K",
      "endpoints": [
        "https://github.com/josephlilleberg/boulder-estates-dining/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
